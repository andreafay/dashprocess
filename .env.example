# Google sign-in. Copy this file to .env.local (never commit that file) and fill in the values
# from your Google Cloud "Desktop app" OAuth client. See "Google sign-in" in the README.
# The values are built into the app, so restart `npm run dev` (or rebuild) after changing them.
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=
